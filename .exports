# vim: syntax=sh

# Homebrew：同時支援 Apple Silicon 與 Intel Mac。
if [ -d /opt/homebrew/bin ]; then
    export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:${PATH}"
elif [ -d /usr/local/bin ]; then
    export PATH="/usr/local/bin:/usr/local/sbin:${PATH}"
fi

# 使用者路徑。
if [ -d "${HOME}/Library/Application Support/Herd/bin" ]; then
    export PATH="${HOME}/Library/Application Support/Herd/bin:${PATH}"
fi
export PATH="${HOME}/bin:${HOME}/.local/bin:${HOME}/.composer/vendor/bin:${PATH}"

# 預設工具。
export EDITOR="${EDITOR:-vim}"
export VISUAL="${VISUAL:-$EDITOR}"
export PAGER="${PAGER:-less}"
if command -v delta >/dev/null 2>&1; then
    export GIT_PAGER="${GIT_PAGER:-delta --paging=always}"
else
    export GIT_PAGER="${GIT_PAGER:-less}"
fi
export BLOCKSIZE="k"
export LESS="-FRX"
export LSCOLORS="gxfxcxdxbxegedabagacad"

# 語系。
export LANG="${LANG:-en_US.UTF-8}"
export LC_CTYPE="${LC_CTYPE:-en_US.UTF-8}"
export LC_MESSAGES="${LC_MESSAGES:-en_US.UTF-8}"
export LC_TIME="${LC_TIME:-en_US.UTF-8}"

# history 預設值，供 zsh 與 bash 相容工具使用。
export HISTSIZE=50000
export HISTFILESIZE=50000
export HISTCONTROL=ignoredups
export HISTIGNORE="bg:cd:date:df:du:exit:fg:ll:ls:pwd:rehash:source:top:w"

# 彩色 man page。
export LESS_TERMCAP_mb=$'\E[01;31m'
export LESS_TERMCAP_md=$'\E[01;31m'
export LESS_TERMCAP_me=$'\E[0m'
export LESS_TERMCAP_se=$'\E[0m'
export LESS_TERMCAP_so=$'\E[01;44;33m'
export LESS_TERMCAP_ue=$'\E[0m'
export LESS_TERMCAP_us=$'\E[01;32m'
