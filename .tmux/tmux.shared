# 共用 tmux 設定。

set -g base-index 1
set -g pane-base-index 1
set -s escape-time 0
set -g mouse on

# 狀態列。
set -g status-position bottom
set -g status-interval 5
set -g status-justify left
set -g status-left-length 40
set -g status-right-length 120
set -g status-style "bg=default,fg=colour244"
set -g status-left "#[fg=colour39,bold] #S #[default]"
set -g status-right "#[fg=colour244]%Y-%m-%d #[fg=colour39]%H:%M "
setw -g window-status-format " #I:#W "
setw -g window-status-current-format "#[fg=colour16,bg=colour39,bold] #I:#W #[default]"

# Pane 顏色。
set -g pane-border-style "fg=colour238"
set -g pane-active-border-style "fg=colour39"
set -g message-style "fg=colour231,bg=colour31"
set -g display-panes-active-colour colour39
set -g display-panes-colour colour245
setw -g clock-mode-colour colour39

# 活動通知。
setw -g monitor-activity off
set -g visual-activity off

# 調整 pane 大小。
bind -n F1 resize-pane -U 1
bind -n F2 resize-pane -D 1
bind -n F3 resize-pane -L 1
bind -n F4 resize-pane -R 1
