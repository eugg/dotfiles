# vim: syntax=sh

calc() {
    local result
    result="$(printf 'scale=10;%s\n' "$*" | bc -l | tr -d '\\\n')"
    if [[ "$result" == *.* ]]; then
        printf '%s' "$result" | sed -e 's/^\./0./' -e 's/^-\./-0./' -e 's/0*$//;s/\.$//'
    else
        printf '%s' "$result"
    fi
    printf '\n'
}

mkd() {
    mkdir -p "$1" && cd "$1" || return
}

cdf() {
    cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')" || return
}

targz() {
    local target="${1%/}"
    local tmpFile="${target}.tar"
    local cmd

    [ -n "$target" ] || {
        echo "Usage: targz path"
        return 1
    }

    tar -cvf "$tmpFile" --exclude=".DS_Store" "$target" || return 1

    if command -v pigz >/dev/null 2>&1; then
        cmd="pigz"
    else
        cmd="gzip"
    fi

    echo "Compressing .tar using ${cmd}"
    "$cmd" -v "$tmpFile" || return 1
    echo "${tmpFile}.gz created successfully."
}

fs() {
    if du -b /dev/null >/dev/null 2>&1; then
        du -sbh -- "$@"
    else
        du -sh -- "$@"
    fi
}

dataurl() {
    local mimeType
    mimeType="$(file -b --mime-type "$1")"
    if [[ "$mimeType" == text/* ]]; then
        mimeType="${mimeType};charset=utf-8"
    fi
    printf 'data:%s;base64,%s\n' "$mimeType" "$(openssl base64 -A -in "$1")"
}

server() {
    local port="${1:-8000}"
    python3 -m http.server "$port"
}

phpserver() {
    local port="${1:-4000}"
    local ip
    ip="$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null)"
    php -S "${ip:-127.0.0.1}:${port}"
}

gz() {
    local origsize
    local gzipsize
    local ratio
    origsize="$(wc -c < "$1")"
    gzipsize="$(gzip -c "$1" | wc -c)"
    ratio="$(echo "$gzipsize * 100 / $origsize" | bc -l)"
    printf "orig: %d bytes\n" "$origsize"
    printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio"
}

json() {
    if command -v jq >/dev/null 2>&1; then
        if [ -t 0 ]; then
            jq . <<< "$*"
        else
            jq .
        fi
    elif [ -t 0 ]; then
        python3 -m json.tool <<< "$*"
    else
        python3 -m json.tool
    fi
}

digga() {
    dig +nocmd "$1" any +multiline +noall +answer
}

escape() {
    printf "\\\x%s" $(printf '%s' "$*" | xxd -p -c1 -u)
    [ -t 1 ] && echo
}

unidecode() {
    perl -e "binmode(STDOUT, ':utf8'); print \"$*\""
    [ -t 1 ] && echo
}

codepoint() {
    perl -e "use utf8; print sprintf('U+%04X', ord(\"$*\"))"
    [ -t 1 ] && echo
}

getcertnames() {
    if [ -z "$1" ]; then
        echo "ERROR: No domain specified."
        return 1
    fi

    local domain="$1"
    local tmp
    local certText

    echo "Testing ${domain}"
    tmp="$(printf 'GET / HTTP/1.0\n\n' | openssl s_client -servername "$domain" -connect "${domain}:443" 2>&1)"

    if [[ "$tmp" != *"-----BEGIN CERTIFICATE-----"* ]]; then
        echo "ERROR: Certificate not found."
        return 1
    fi

    certText="$(printf '%s' "$tmp" | openssl x509 -text -certopt no_header,no_serial,no_version,no_signame,no_validity,no_issuer,no_pubkey,no_sigdump,no_aux)"
    echo "Common Name:"
    printf '%s\n' "$certText" | grep "Subject:" | sed -e "s/^.*CN=//"
    echo
    echo "Subject Alternative Name(s):"
    printf '%s\n' "$certText" | grep -A 1 "Subject Alternative Name:" | sed -e "2s/DNS://g" -e "s/ //g" | tr "," "\n" | tail -n +2
}

note() {
    local title
    local body
    if [ -t 0 ]; then
        title="$1"
        body="$2"
    else
        title="$1"
        body="$(cat)"
    fi

    osascript >/dev/null <<EOF
tell application "Notes"
    tell account "iCloud"
        tell folder "Notes"
            make new note with properties {name:"$title", body:"$title" & "<br><br>" & "$body"}
        end tell
    end tell
end tell
EOF
}

remind() {
    local text
    if [ -t 0 ]; then
        text="$1"
    else
        text="$(cat)"
    fi

    osascript >/dev/null <<EOF
tell application "Reminders"
    tell the default list
        make new reminder with properties {name:"$text"}
    end tell
end tell
EOF
}

unquarantine() {
    if [ -z "$1" ]; then
        echo "Usage: unquarantine path"
        return 1
    fi
    xattr -r -d com.apple.quarantine "$@"
}
