# vim: syntax=sh

# 一般工具。
alias less="/usr/bin/less -FRX"
alias more="less"
alias cd..="cd .."
alias cd...="cd ../.."
alias sshp="ssh -p 222"
alias cleandns="sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"
alias i5="iconv -f BIG5 -t UTF-8"
alias path='printf "%s\n" "${PATH//:/\\n}"'

# 有安裝現代工具時優先使用。
if command -v eza >/dev/null 2>&1; then
    alias ls="eza --group-directories-first --icons=auto"
    alias ll="eza -la --group-directories-first --icons=auto --git"
    alias tree="eza --tree --icons=auto"
else
    case "$(uname)" in
        Darwin)
            alias ls="ls -aFG"
            alias ll="ls -alG"
            ;;
        Linux)
            alias ls="ls -aF --color=auto"
            alias ll="ls -al --color=auto"
            ;;
        FreeBSD)
            alias ls="ls -aFGg"
            alias ll="ls -aGg"
            ;;
    esac
fi

if command -v bat >/dev/null 2>&1; then
    alias cat="bat --paging=never"
fi

if command -v rg >/dev/null 2>&1; then
    alias grep="rg"
fi

if command -v delta >/dev/null 2>&1; then
    alias diff="delta"
fi

# 網路。
alias ip="dig +short myip.opendns.com @resolver1.opendns.com"

# Laravel / PHP。
alias pa="php artisan"
alias pam="php artisan migrate"
alias pam:fresh="php artisan migrate:fresh"
alias pam:roll="php artisan migrate:rollback"
alias pam:rs="php artisan migrate:fresh --seed"
alias ci="composer install"
alias cu="composer update"
alias cda="composer dump-autoload -o"
